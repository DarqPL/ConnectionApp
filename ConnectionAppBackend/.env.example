# Admin account (auto-seeded on first startup)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin@123456
APP_ADMIN_EMAIL=admin@appchat.local
APP_ADMIN_DISPLAY_NAME=Administrators

# AWS S3 (.env)
DB_USERNAME=root
DB_PASSWORD=your-db-password
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Backend host binding for LAN testing
APP_SERVER_PORT=8080
APP_SERVER_ADDRESS=0.0.0.0

# Allow local browser/mobile clients and private LAN ranges.
# Include your VS Code forwarded port domain, for example https://*.asse.devtunnels.ms
# You can replace this list with exact origins if you want stricter CORS.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*:*,http://10.*:*,http://172.16.*:*,http://172.17.*:*,http://172.18.*:*,http://172.19.*:*,http://172.2*.*:*,https://*.asse.devtunnels.ms,exp://*

# For web -> backend requests across HTTPS forwarded origins.
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=None

S3_REGION=ap-southeast-1
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=images

# Upload limit per file
# Examples: 2MB, 5MB, 10MB
APP_UPLOAD_MAX_FILE_SIZE=2MB

# Temporary lock after policy violation (minutes)
APP_SECURITY_TEMP_LOCK_MINUTES=30

# Gemini safety filter for group media
APP_AI_SAFETY_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
APP_AI_SAFETY_MODEL=gemini-3-flash-preview
APP_AI_SAFETY_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_SAFETY_TIMEOUT_MS=12000
APP_AI_SAFETY_HIGH_CONFIDENCE_THRESHOLD=0.85
# Allowed: GROUP | PRIVATE | BOTH
APP_AI_SAFETY_CONVERSATION_SCOPE=GROUP

# Gemini AI rewrite for drafted message
APP_AI_REWRITE_ENABLED=true
APP_AI_REWRITE_API_KEY=your-gemini-api-key
APP_AI_REWRITE_MODEL=gemini-3-flash-preview
APP_AI_REWRITE_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
APP_AI_REWRITE_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_REWRITE_TIMEOUT_MS=12000
APP_AI_REWRITE_MAX_CONTEXT_MESSAGES=20
APP_AI_REWRITE_MAX_RETRIES=1

# Zego call integration
ZEGO_APP_ID=0
ZEGO_SERVER_SECRET=your-zego-server-secret
APP_ZEGO_TOKEN_TTL_SECONDS=3600
APP_CALL_RING_TIMEOUT_SECONDS=30
APP_CALL_TIMEOUT_SCAN_MS=5000
