# AWS S3 (.env)
DB_USERNAME=root
DB_PASSWORD=your-db-password
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

S3_REGION=ap-southeast-1
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=images

# Upload limit per file
# Examples: 2MB, 5MB, 10MB
APP_UPLOAD_MAX_FILE_SIZE=2MB

# Temporary lock after policy violation (minutes)
APP_SECURITY_TEMP_LOCK_MINUTES=30

# Gemini safety filter for group media
APP_AI_SAFETY_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
APP_AI_SAFETY_MODEL=gemini-3-flash-preview
APP_AI_SAFETY_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_SAFETY_TIMEOUT_MS=12000
APP_AI_SAFETY_HIGH_CONFIDENCE_THRESHOLD=0.85
# Allowed: GROUP | PRIVATE | BOTH
APP_AI_SAFETY_CONVERSATION_SCOPE=GROUP