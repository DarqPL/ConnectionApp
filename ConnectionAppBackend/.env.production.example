# ============================================================
# Production .env for EC2 deployment
# Copy this file to .env and fill in your values
# cp .env.production.example .env
# ============================================================

# --- Admin account (auto-seeded on first startup) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_StrongPassword123!
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_DISPLAY_NAME=Administrator

# --- Database ---
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_StrongDbPassword123!

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appchat?retryWrites=true&w=majority

# --- Email (Gmail SMTP) ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# --- AWS S3 ---
S3_REGION=ap-southeast-1
S3_BUCKET=your-s3-bucket
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=images

# --- Upload limit ---
APP_UPLOAD_MAX_FILE_SIZE=5MB

# --- Security ---
APP_SECURITY_TEMP_LOCK_MINUTES=30

# --- Gemini AI Safety ---
APP_AI_SAFETY_ENABLED=true
APP_AI_SAFETY_CONVERSATION_SCOPE=GROUP
GEMINI_API_KEY=your-gemini-api-key
APP_AI_SAFETY_MODEL=gemini-3-flash-preview
APP_AI_SAFETY_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_SAFETY_TIMEOUT_MS=20000
APP_AI_SAFETY_HIGH_CONFIDENCE_THRESHOLD=0.85

# --- Gemini AI Rewrite ---
APP_AI_REWRITE_ENABLED=true
APP_AI_REWRITE_API_KEY=your-gemini-api-key
APP_AI_REWRITE_MODEL=gemini-3-flash-preview
APP_AI_REWRITE_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
APP_AI_REWRITE_BASE_URL=https://generativelanguage.googleapis.com
APP_AI_REWRITE_TIMEOUT_MS=20000
APP_AI_REWRITE_MAX_CONTEXT_MESSAGES=20
APP_AI_REWRITE_MAX_RETRIES=1

# --- Server ---
APP_SERVER_PORT=8080
APP_SERVER_ADDRESS=0.0.0.0

# --- CORS (add your Vercel domain + your backend domain) ---
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-app.vercel.app,https://api.yourdomain.com,exp://*

# --- Auth cookies (must be secure + None for HTTPS cross-site) ---
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=None

# --- Zego Call ---
ZEGO_APP_ID=your-zego-app-id
ZEGO_SERVER_SECRET=your-zego-server-secret
APP_ZEGO_TOKEN_TTL_SECONDS=3600
APP_CALL_RING_TIMEOUT_SECONDS=30
APP_CALL_TIMEOUT_SCAN_MS=5000

APP_ADMIN_CONTACT_EMAIL=yourmail@gmail.com