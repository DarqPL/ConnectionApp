# Max upload size per file in bytes (Expo public env)
# Example: 2097152 = 2MB, 5242880 = 5MB ; 1MB = 1*1024*1024 = 1048576 bytes
EXPO_PUBLIC_MAX_UPLOAD_FILE_SIZE_BYTES=2097152

# Optional LAN override for development builds on physical devices.
# Example: 192.168.1.10
EXPO_PUBLIC_DEV_SERVER_HOST=

# Optional full backend URL override.
# Example LAN: http://192.168.1.10:8080/api
EXPO_PUBLIC_API_BASE_URL=

# Optional public web URL used to build/copy group invite links and QR payloads.
# Example local web: http://192.168.1.10:5173
# Example forwarded web: https://xxxx-5173.asse.devtunnels.ms
EXPO_PUBLIC_WEB_APP_URL=

# Toggle between LAN backend and VS Code forwarded backend URL.
# false = use EXPO_PUBLIC_API_BASE_URL / LAN fallback
# true = prefer EXPO_PUBLIC_FORWARDED_API_BASE_URL
EXPO_PUBLIC_USE_FORWARDED_API=false

# Optional HTTPS backend URL from VS Code forwarded port / dev tunnel.
# Example: https://xxxx-8080.asse.devtunnels.ms/api
EXPO_PUBLIC_FORWARDED_API_BASE_URL=

# Call UI/runtime config
EXPO_PUBLIC_ZEGO_APP_ID=0
EXPO_PUBLIC_ZEGO_APP_SIGN=
EXPO_PUBLIC_CALL_RING_TIMEOUT_SECONDS=30
