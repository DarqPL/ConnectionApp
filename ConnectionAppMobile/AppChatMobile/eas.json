{
  "cli": {
    "version": ">= 18.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ZEGO_APP_ID": "EXPO_PUBLIC_ZEGO_APP_ID",
        "EXPO_PUBLIC_ZEGO_APP_SIGN": "EXPO_PUBLIC_ZEGO_APP_SIGN",
        "EXPO_PUBLIC_API_BASE_URL": "https://connection-app.online/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://connection-app-murex.vercel.app",
        "EXPO_PUBLIC_MAX_UPLOAD_FILE_SIZE_BYTES": "10485760",
        "EXPO_PUBLIC_CALL_RING_TIMEOUT_SECONDS": "30"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ZEGO_APP_ID": "EXPO_PUBLIC_ZEGO_APP_ID",
        "EXPO_PUBLIC_ZEGO_APP_SIGN": "EXPO_PUBLIC_ZEGO_APP_SIGN",
        "EXPO_PUBLIC_API_BASE_URL": "https://connection-app.online/api",
        "EXPO_PUBLIC_WEB_APP_URL": "https://connection-app-murex.vercel.app",
        "EXPO_PUBLIC_MAX_UPLOAD_FILE_SIZE_BYTES": "10485760",
        "EXPO_PUBLIC_CALL_RING_TIMEOUT_SECONDS": "30"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
