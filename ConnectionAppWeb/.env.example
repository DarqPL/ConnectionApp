# Optional LAN host for Vite dev clients running on other devices.
# Example: 192.168.1.204
VITE_DEV_SERVER_HOST=

# Optional full backend URL override.
# Example LAN: http://192.168.1.204:8080/api
# Example forwarded: https://xxxx-8080.asse.devtunnels.ms/api
VITE_API_BASE_URL=

# Optional public web URL used for forwarded HTTPS guidance/errors.
# Example: https://yyyy-5173.asse.devtunnels.ms
VITE_PUBLIC_APP_URL=

# Max upload size per file in bytes
# Example: 2097152 = 2MB, 5242880 = 5MB; 1MB = 1*1024*1024 = 1048576 bytes
VITE_MAX_UPLOAD_FILE_SIZE_BYTES=2097152

# Call UI/runtime config
VITE_ZEGO_APP_ID=0
VITE_CALL_RING_TIMEOUT_SECONDS=30
